# Copy to images/.env and fill in. images/.env is gitignored and must stay that
# way: no credential enters this repo, not even a local one.
MYSQL_ROOT_PASSWORD=

# The login the `backup` service dumps with (../deploy/README.md, The dump
# login), which writes no table directly; its exceptions are the capture fence
# procedures and trigger DDL. At least 24 characters, [A-Za-z0-9] only. The
# `dump-login` service creates or rotates it on every `up`, and refuses to let
# `backup` start while this is empty.
RIFTAL_DB_PASSWORD_BACKUP=

# The mines MySQL login's password (ADR 008). The migration runner provisions
# the login with it and `instance` hands it to RiftalMines, so both read it
# from here. At least 24 characters, [A-Za-z0-9] only, or the runner refuses
# it. Needed once RiftalMines.phar is built: see plugins/instance-only/README.md.
RIFTAL_DB_PASSWORD_MINES=

# The ranks MySQL login's password (ADR 008). The migration runner provisions
# the login with it and `instance` hands it to RiftalRanks, so both read it
# from here. At least 24 characters, [A-Za-z0-9] only, or the runner refuses
# it. Needed once RiftalRanks.phar is built: see plugins/instance-only/README.md.
RIFTAL_DB_PASSWORD_RANKS=

# The gangs MySQL login's password. The migration runner provisions the login
# with it and riftal-pm's dev stack requires it. compose.yaml hands it to no
# container. At least 24 characters, [A-Za-z0-9] only, or the runner refuses
# it.
RIFTAL_DB_PASSWORD_GANGS=

# The plots MySQL login's password. The migration runner provisions the login
# with it and riftal-pm's dev stack requires it. Both instances hand it to
# RiftalPlots, needed once RiftalPlots.phar is built: see
# plugins/instance-only/README.md. At least 24 characters, [A-Za-z0-9] only,
# or the runner refuses it.
RIFTAL_DB_PASSWORD_PLOTS=

# The economy MySQL login's password, under the same rules as the ranks one.
# Needed once RiftalEconomy.phar is built: see plugins/instance-only/README.md.
RIFTAL_DB_PASSWORD_ECONOMY=

# Host interface the instance publishes 19132/udp on. 127.0.0.1 keeps it on
# this machine. 0.0.0.0 puts an offline-mode server on the LAN, which is what
# joining from a phone needs and is never correct on a public interface.
INSTANCE_BIND=127.0.0.1

# This instance's identity, tagged onto every shared-database row it writes.
# Short and stable, never reused once a world has state under it: see
# /add-instance. The dev stack runs one instance, so dev-1 is fine as is.
INSTANCE_ID=dev-1

# The accounts MySQL login's password (ADR 008). The migration runner
# provisions the login with it and both instances hand it to RiftalAccounts,
# so all three read it from here. At least 24 characters, [A-Za-z0-9] only, or
# the runner refuses it. Every instance boot needs it: see README.md,
# RiftalAccounts.
RIFTAL_DB_PASSWORD_ACCOUNTS=

# The second instance (`instance-b`), proving the instance-split shape on the
# same MySQL (riftal-infra#6). Same rules as INSTANCE_BIND and INSTANCE_ID
# above, on their own vars because both instances read the same-named
# INSTANCE_ID inside their own containers and would otherwise collide on one
# value from this file.
INSTANCE_B_BIND=127.0.0.1
INSTANCE_B_ID=dev-2

# How many backup sets the `backup` service keeps before pruning the oldest,
# and how often it takes one, in seconds. First-pass placeholders from
# docs/specs/008-backup-and-restore.md: every 6 hours, keep the last 10.
BACKUP_RETENTION=10
BACKUP_INTERVAL_SECONDS=21600

# How old a leftover `.partial` backup directory (a run killed non-gracefully
# before it could rename itself into a completed set) must be, in minutes,
# before the next run sweeps it away. Matches BACKUP_INTERVAL_SECONDS's
# six hours: a run that stale is never coming back to finish (riftal-infra#151).
PARTIAL_MAX_AGE_MINUTES=360

# How old a held .lock directory (rename-based, released only by backup.sh's
# own EXIT trap) must be, in minutes, before the next run presumes it
# abandoned, clears it, and retries. Well above the mysqldump-plus-tar
# duration any real run should ever take, and well below
# PARTIAL_MAX_AGE_MINUTES, since the lock is held only for a run's own active
# work, not the idle time between scheduled runs (riftal-infra#171).
LOCK_MAX_AGE_MINUTES=90

# How long a running instance has to ack a backup's capture request, in
# seconds, before the run fails naming its volume, and how long the hold may
# last at most, the lease every instance enforces on itself (ADR 015 items 6
# and 8). The lease must cover the longest tar, retry included, and stay well
# below LOCK_MAX_AGE_MINUTES.
CAPTURE_ACK_TIMEOUT_SECONDS=60
CAPTURE_HOLD_MAX_SECONDS=900

# How long the capture fence row stays raised at most, in seconds: from before
# the dump until every volume is verified (ADR 027 item 5). It must be above
# CAPTURE_HOLD_MAX_SECONDS, since it covers the dump as well as the hold, and
# at most 3600, which capture_fence_raise enforces. backup.sh refuses to start
# otherwise. After a killed run, commit-first flows stay refused for the rest
# of this lease.
CAPTURE_FENCE_MAX_SECONDS=1800

# Seconds a run stalls between its dump and its capture request. Zero outside
# the self-tests, which act in that gap.
FENCE_TEST_STALL_SECONDS=0
