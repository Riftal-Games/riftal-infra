# Copy to images/.env and fill in. images/.env is gitignored and must stay that
# way: no credential enters this repo, not even a local one.
MYSQL_ROOT_PASSWORD=

# Host interface the instance publishes 19132/udp on. 127.0.0.1 keeps it on
# this machine. 0.0.0.0 puts an offline-mode server on the LAN, which is what
# joining from a phone needs and is never correct on a public interface.
INSTANCE_BIND=127.0.0.1
