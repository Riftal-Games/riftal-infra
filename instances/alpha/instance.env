# The closed alpha instance. No secret belongs in this file: each login's
# RIFTAL_DB_PASSWORD_<NAME> is set in the compose's environment.
RIFTAL_LEVEL_ZONES=lumber mine_a mine_b mine_c
POCKETMINE_ARGS=--xbox-auth=true --auto-report.enabled=0 --level-name=mine_a
RIFTAL_PLUGINS=RiftalMines RiftalRanks RiftalEconomy
RIFTAL_DB_HOST=mysql
RIFTAL_DB_SCHEMA=riftal_alpha
