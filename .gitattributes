# Authored on Windows, read on Linux in CI and in containers. A CRLF shebang
# makes a script's interpreter unfindable; the rest stay LF to be byte-stable.
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.template text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sha text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
Containerfile text eol=lf
