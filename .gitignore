# Secrets never enter this repo. Database credentials, proxy keys, and host
# access live in the deployment secret store, not in git.
*.env
.env
# A fixture definition carries flags and zone names, never a credential.
!.github/ci-fixtures/good/alpha/instances/*/instance.env
secrets/
*.key
*.pem

# Artifacts pulled in during a deploy
*.jar
*.phar

# Backups and dumps
*.sql.gz
backups/

CLAUDE.local.md

# This repo's own skills and agent files under .claude/ are the deliberate
# exception to the global ignore of `.claude/` in ~/.gitignore_global. Without
# these negations a new skill or agent file added here is silently dropped and
# never reaches git.
!.claude/
!.claude/**

# Must come after the negations above so it stays the last matching rule;
# otherwise the broader !.claude/** re-includes this local, per-machine file.
.claude/settings.local.json
